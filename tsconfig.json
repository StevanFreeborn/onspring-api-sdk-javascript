{
  "compilerOptions": {
    "strictNullChecks": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "esModuleInterop": true,
    "target": "ES6",
    "moduleResolution": "node",
    "types": ["mocha", "node"]
  },
  "include": ["src/**/*", "tests/**/*", "integrationTests/**/*"],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "target": "ES6"
    },
    "experimentalResolver": true,
    "moduleTypes": {
      "*.ts": "cjs"
    }
  }
}
